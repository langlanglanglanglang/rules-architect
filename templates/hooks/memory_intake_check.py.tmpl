#!/usr/bin/env python3
"""
PreToolUse hook: when assistant writes to a CC memory file
(MEMORY.md, feedback_*.md, reference_*.md under any memory/ dir),
inject the 5-question rule placement SOP.

Dual-runtime — works under both Claude Code and Codex CLI:
  - Claude Code: Write/Edit/MultiEdit tools carry tool_input.file_path
  - Codex CLI:   apply_patch tool carries only tool_input.command (patch text);
                 target paths are parsed from the `*** Add/Update/Delete/Move`
                 headers. Codex's hook I/O contract (snake_case stdin fields +
                 hookSpecificOutput.additionalContext) is identical to CC's, so
                 the same script serves both — only path extraction differs.

Self-contained — does not reference external CLAUDE.md sections and imports
nothing beyond stdlib (the apply_patch parser is inlined by design).
Generic — works with any CC / codex project.

Dedupe: per-session lock (~/.cache/claude-hooks/memory-intake-<sid>.lock,
        auto-cleaned at SessionStart by cleanup_hook.py)
Audit:  ~/.cache/claude-hooks/audit.jsonl

Installed by rules-architect skill v{{SKILL_VERSION}}
"""
import json
import os
import re
import sys
import time
from pathlib import Path


def get_cache_dir() -> Path:
    """Cross-platform cache directory."""
    xdg = os.environ.get("XDG_CACHE_HOME")
    if xdg:
        return Path(xdg) / "claude-hooks"
    if sys.platform == "win32":
        local = os.environ.get("LOCALAPPDATA")
        if local:
            return Path(local) / "Claude" / "cache" / "claude-hooks"
    return Path.home() / ".cache" / "claude-hooks"


CACHE = get_cache_dir()
CACHE.mkdir(parents=True, exist_ok=True)


def log_audit(hook: str, decision: str, **kwargs) -> None:
    rec = {"ts": time.time(), "hook": hook, "decision": decision, **kwargs}
    try:
        with open(CACHE / "audit.jsonl", "a") as f:
            f.write(json.dumps(rec, ensure_ascii=False, default=str) + "\n")
    except Exception:
        pass


# apply_patch (Codex) has no structured path field — parse the patch headers.
# Covers: "*** Add File: x", "*** Update File: x", "*** Delete File: x",
# "*** Move to: x". Verified against Codex CLI v0.144.x apply_patch payloads.
_PATCH_PATH_RE = re.compile(
    r"^\*\*\* (?:Add File|Update File|Delete File|Move to):\s+(.+?)\s*$",
    re.MULTILINE,
)


def paths_from_apply_patch(command: str) -> list:
    """Extract touched file paths from an apply_patch command string."""
    if not isinstance(command, str) or not command:
        return []
    return [m.group(1).strip().strip('"') for m in _PATCH_PATH_RE.finditer(command)]


def candidate_paths(tool_input: dict) -> list:
    """All file paths this tool call would touch, across CC and Codex shapes."""
    if not isinstance(tool_input, dict):
        return []
    paths = []
    # Claude Code: Write/Edit/MultiEdit
    fp = tool_input.get("file_path")
    if isinstance(fp, str) and fp:
        paths.append(fp)
    # Codex: apply_patch (patch text in tool_input.command)
    paths.extend(paths_from_apply_patch(tool_input.get("command", "")))
    return paths


def is_memory_path(p: str) -> bool:
    """Detect memory files: <any>/memory/MEMORY.md, feedback_*.md, reference_*.md.

    Segment-aware (not a raw substring test) so it also matches Codex
    apply_patch relative paths like "memory/feedback_x.md" (no leading slash),
    where the old "/memory/" substring check would silently miss root-level
    memory writes.
    """
    if not isinstance(p, str) or not p:
        return False
    parts = p.replace("\\", "/").split("/")
    if "memory" not in parts[:-1]:   # 'memory' must be a directory component
        return False
    name = parts[-1].lower()
    return (
        name == "memory.md"
        or name.startswith("feedback_")
        or name.startswith("reference_")
    )


# Self-contained reminder — full 5-Q SOP embedded, no external references.
REMINDER = """**About to write to a CC memory file**. Before saving, walk the 5-Question Placement SOP:

| # | Question | Pick layer |
|---|---|---|
| 1 | Can trigger condition be expressed by tool/matcher? | **L0 hook** / **L2 path-scoped** |
| 2 | Only relevant when editing specific files/dirs? | **L2** `.claude/rules/` |
| 3 | All team members need it (incl. codex/gemini users)? | **L3** CLAUDE.md / **L5** lessons |
| 4 | Personal collaboration preference only? | Current path OK (**L1 memory**) |
| 5 | Overlaps with existing rule? grep keywords → yes → edit existing |  |

**FORBIDDEN**: skipping the 5 questions and defaulting to L1 memory. This is the #1 leakage.

If you have walked the 5 questions and confirmed L1: output user-visible text first stating
"5-Q walked, going L1 memory because: ..." then proceed.

This reminder fires once per session via dedupe lock.
Installed by rules-architect skill."""


def main() -> int:
    try:
        data = json.load(sys.stdin)
    except Exception:
        return 0
    if not isinstance(data, dict):
        return 0

    session_id = data.get("session_id", "unknown")
    tool_input = data.get("tool_input") or {}

    hit = next((p for p in candidate_paths(tool_input) if is_memory_path(p)), None)
    if hit is None:
        return 0

    lock = CACHE / f"memory-intake-{session_id}.lock"
    if lock.exists():
        log_audit("memory_intake_check", "dedupe-skip",
                  session=session_id, path=hit)
        return 0
    lock.touch()

    output = {"hookSpecificOutput": {"hookEventName": "PreToolUse", "additionalContext": REMINDER}}
    print(json.dumps(output, ensure_ascii=False))
    log_audit("memory_intake_check", "inject",
              session=session_id, path=hit)
    return 0


if __name__ == "__main__":
    sys.exit(main())
