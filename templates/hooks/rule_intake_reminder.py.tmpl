#!/usr/bin/env python3
"""
UserPromptSubmit hook: when user message contains keywords suggesting new
rule generation (Chinese: "以后...必须...", English: "from now on, always..."),
inject the 5-question rule placement SOP.

Self-contained, parametrized keyword presets.

Pattern selection via env var RULE_INTAKE_KEYWORDS:
  - "chinese" (default): 以后/下次/每次/凡是 patterns
  - "english": from now on / always / never patterns
  - any other value: treated as a raw regex (advanced users)

Tightened patterns:
  - Require imperative/modal verb after trigger word
  - Refuse to match if the sentence ends with '?' or '？' (question, not rule)

Dedupe: per-session lock
Audit:  ~/.cache/claude-hooks/audit.jsonl

由 rules-architect Skill v{{SKILL_VERSION}} 安装
"""
import json
import os
import re
import sys
import time
from pathlib import Path


def get_cache_dir() -> Path:
    xdg = os.environ.get("XDG_CACHE_HOME")
    if xdg:
        return Path(xdg) / "claude-hooks"
    if sys.platform == "win32":
        local = os.environ.get("LOCALAPPDATA")
        if local:
            return Path(local) / "Claude" / "cache" / "claude-hooks"
    return Path.home() / ".cache" / "claude-hooks"


CACHE = get_cache_dir()
CACHE.mkdir(parents=True, exist_ok=True)


# === Keyword preset selection ===
# Tightened: require imperative/modal verb; refuse sentences ending in ?/？
PRESETS = {
    "chinese": (
        # 以后 X 必须/应该/要/不要 (where X is non-punctuation chars, max 15)
        r"以后[^，。!！\n]{0,15}(?:必须|应该|要|不要|不准|禁止|得|别|开始)"
        r"|下次[^，。!！\n]{0,15}(?:别|不要|要|得|记住)"
        r"|每次[^，。!！\n]{0,15}(?:都|必须|得|要|记)"
        r"|凡是[^，。!！\n]{0,15}(?:都|必须|得|要)"
        r"|从今(?:天|以)?(?:起|后)"
        r"|新规则"
        r"|这条得记"
        r"|你(?:这套|的)?规则"
    ),
    "english": (
        r"\bfrom now on\b[^?\n]{0,40}(?:must|should|always|never|don't|do not)"
        r"|\balways\b[^?\n]{0,40}(?:must|should|do|don't|do not)"
        r"|\bnever\b[^?\n]{0,40}(?:should|do|use)"
        r"|\bevery time\b[^?\n]{0,40}(?:must|should|need to|need|don't|do not)"
        r"|\bnew rule\b"
        r"|\bremember\b[^?\n]{0,20}(?:this|that)"
        r"|\bgoing forward\b"
    ),
}

keyword_choice = os.environ.get("RULE_INTAKE_KEYWORDS", "{{RULE_INTAKE_KEYWORDS}}").strip()
if keyword_choice in PRESETS:
    pattern_src = PRESETS[keyword_choice]
else:
    # Treat as raw regex (advanced). NOTE: a pathological custom pattern can
    # still cause slow backtracking (ReDoS) — custom values are at your own risk.
    pattern_src = keyword_choice

try:
    PATTERN = re.compile(pattern_src, re.IGNORECASE)
except re.error:
    # Invalid custom regex → fall back to the safe default preset rather than
    # crashing the hook (and thus the session) on every invocation.
    PATTERN = re.compile(PRESETS["chinese"], re.IGNORECASE)


def log_audit(hook: str, decision: str, **kwargs) -> None:
    if os.environ.get("RA_AUDIT_DISABLE"):
        return
    rec = {"ts": time.time(), "hook": hook, "decision": decision, **kwargs}
    try:
        with open(CACHE / "audit.jsonl", "a") as f:
            f.write(json.dumps(rec, ensure_ascii=False, default=str) + "\n")
    except Exception:
        pass


# Self-contained 5-Q SOP — no external references.
REMINDER_TEMPLATE = """**用户消息包含规则引入关键词**（匹配：`{match}`）。

保存任何新规则前，必须完成**五问归位 SOP**：

| # | 问题 | 选择层级 |
|---|---|---|
| 1 | 触发条件能用 tool/matcher 精确表达吗？ | **L0 Hook** / **L2 路径规则** |
| 2 | 只在编辑特定文件或目录时相关吗？ | **L2** `.claude/rules/` |
| 3 | 全团队都需要吗（包括 Codex/Gemini 用户）？ | **L3** CLAUDE.md / **L5** Lessons |
| 4 | 只是个人协作偏好吗？ | **L1 Memory** |
| 5 | 与已有规则重叠吗？先检索；重叠则修改已有规则 |  |

**反模式**：所有新规则都默认放进 L1 Memory，既容易遗忘，团队也看不到。

执行前先向用户说明选择的层级和原因：
> “这条规则应放在 LX，因为：……”

本提醒每个会话只触发一次，由 rules-architect Skill 安装。"""


def main() -> int:
    try:
        data = json.load(sys.stdin)
    except Exception:
        return 0
    if not isinstance(data, dict):
        return 0

    # Sanitize the runtime-supplied session id before it lands in a lock
    # filename (prevents path traversal / lock collision via crafted ids).
    session_id = re.sub(
        r"[^A-Za-z0-9_-]", "_", str(data.get("session_id", "unknown"))
    )[:128]
    prompt = (
        data.get("prompt")
        or data.get("user_prompt")
        or data.get("message")
        or ""
    )
    if not isinstance(prompt, str):
        return 0

    # Reject question sentences explicitly (sentence ends with ?/？)
    # Find first sentence-like fragment containing match
    m = PATTERN.search(prompt)
    if not m:
        return 0

    # Find sentence boundary around the match — if ends with ?/？, skip
    start = m.start()
    sentence_end_chars = "。.!?！？\n"
    end_idx = len(prompt)
    for i in range(start, len(prompt)):
        if prompt[i] in sentence_end_chars:
            end_idx = i + 1
            break
    sentence = prompt[start:end_idx].strip()
    if sentence.endswith("?") or sentence.endswith("？"):
        log_audit("rule_intake_reminder", "skip-question",
                  session=session_id, sentence=sentence[:50])
        return 0

    lock = CACHE / f"rule-intake-{session_id}.lock"
    if lock.exists():
        log_audit("rule_intake_reminder", "dedupe-skip",
                  session=session_id, match=m.group(0))
        return 0
    lock.touch()

    reminder = REMINDER_TEMPLATE.format(match=m.group(0))
    output = {"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": reminder}}
    print(json.dumps(output, ensure_ascii=False))
    log_audit("rule_intake_reminder", "inject",
              session=session_id, match=m.group(0), preset=keyword_choice)
    return 0


if __name__ == "__main__":
    sys.exit(main())
