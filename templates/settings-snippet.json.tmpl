{
  "_comment": "rules-architect skill v2.0.0 — these hook entries get merged into ~/.claude/settings.json by install_hooks.py via JSON deep-merge. Each entry is owned by the skill and tracked in ~/.claude/.rules-architect-manifest.json. uninstall.py removes only these specific entries (not the entire hooks section).",
  "hooks": {
    "PreToolUse": [
      {
        "_owner": "rules-architect",
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory_intake_check.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "_owner": "rules-architect",
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/rule_intake_reminder.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "_owner": "rules-architect",
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cleanup_hook.py"
          }
        ]
      }
    ]
  }
}